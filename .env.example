# Environment Variables Template
# Copy this file to .env.development for local development
# Copy this file to .env.production for production builds

# API Base URL
VITE_API_BASE_URL=http://localhost:3000/api

VITE_OKTA_ISSUER=https://dev-xxxxxxxx.okta.com/oauth2/default
VITE_OKTA_CLIENT_ID=xxxxxxxxxxxxxxxx
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback
VITE_OKTA_POST_LOGOUT_URI=http://localhost:5173
VITE_OKTA_SCOPES=openid profile email

# Later we can also add
# VITE_OKTA_PKCE=trueasdfasdfasdf